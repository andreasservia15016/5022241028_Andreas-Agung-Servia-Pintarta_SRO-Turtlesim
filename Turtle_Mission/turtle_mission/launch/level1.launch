<launch>
  <!-- Argumen untuk memulai misi otomatis atau menunggu panggilan service manual -->
  <arg name="auto_start" default="true" />

  <!-- 1. Jalankan simulator turtlesim -->
  <node pkg="turtlesim" type="turtlesim_node" name="turtlesim_node" output="screen" />

  <!-- 2. Jalankan node Mission Manager dan muat parameter waypoints.yaml -->
  <node pkg="turtle_mission" type="mission_manager.py" name="mission_manager" output="screen">
    <rosparam command="load" file="$(find turtle_mission)/config/waypoints.yaml" />
  </node>

  <!-- 3. Jalankan node Waypoint Controller beserta parameter P-Controller -->
  <node pkg="turtle_mission" type="waypoint_controller.py" name="waypoint_controller" output="screen">
    <param name="kp_lin" value="1.5" />
    <param name="kp_ang" value="6.0" />
    <param name="tolerance" value="0.08" />
    <param name="max_lin_vel" value="2.5" />
    <param name="max_ang_vel" value="4.0" />
  </node>

  <!-- 4. Opsional: Panggil service /start_mission otomatis -->
  <node if="$(arg auto_start)" pkg="rosservice" type="rosservice" name="auto_start_mission"
        args="call --wait /start_mission 'start: true'" output="screen" />
</launch>
